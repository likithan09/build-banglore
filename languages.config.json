{
  "sarvam_models": {
    "stt": {
      "default_model": "saaras:v2",
      "fallback_model": "saarika:v1",
      "endpoint": "/speech-to-text",
      "modes": ["transcribe", "translate", "verbatim"]
    },
    "tts": {
      "default_model": "bulbul:v1",
      "fallback_model": "bulbul:v2",
      "endpoint": "/text-to-speech",
      "default_pace": 1.0,
      "audio_format": "mp3"
    },
    "translation": {
      "default_model": "mayura:v1",
      "longform_model": "sarvam-translate:v1",
      "endpoint": "/translate"
    },
    "chat": {
      "default_model": "sarvam-2b",
      "endpoint": "/chat/completions"
    }
  },
