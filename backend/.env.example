# ==============================================================================
# KALASETU Backend Environment Configuration
# ==============================================================================

# Application & Server Settings
APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000
SECRET_KEY=kalasetu_artisan_marketplace_secret_jwt_key_2026_indic
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 1. Aiven Managed Services Configuration (Mandatory Tech Stack §4)
# Free tier credentials from https://aiven.io/docs
# ------------------------------------------------------------------------------

# Aiven PostgreSQL: users, profiles, products, inventory, orders, inquiries
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>?ssl=require
AIVEN_PG_URI=postgresql+asyncpg://avnadmin:your_password@your-pg-instance.aivencloud.com:12345/defaultdb?ssl=require
DATABASE_URL=sqlite:///./kalasetu.db

# Aiven Apache Kafka: decoupled event bus for orders, catalog, connections, inventory
# Format: <host>:<port> (e.g., your-kafka-instance.aivencloud.com:12346)
AIVEN_KAFKA_BOOTSTRAP_SERVERS=your-kafka-instance.aivencloud.com:12346
AIVEN_KAFKA_TOPIC_PREFIX=kalasetu.
AIVEN_KAFKA_CA_CERT=/path/to/ca.pem
AIVEN_KAFKA_CLIENT_CERT=/path/to/service.cert
AIVEN_KAFKA_CLIENT_KEY=/path/to/service.key

# Aiven OpenSearch: fuzzy search, typo tolerance, multi-lingual analyzers
# Format: https://<user>:<password>@<host>:<port>
AIVEN_OPENSEARCH_URI=https://avnadmin:your_password@your-opensearch.aivencloud.com:12347
OPENSEARCH_INDEX=kalasetu_products

# ------------------------------------------------------------------------------
# 2. External Compliance & AI Credentials
# ------------------------------------------------------------------------------

# Sandbox.co.in API Credentials (GSTIN & PAN Verification §6)
# Get keys at: https://sandbox.co.in
SANDBOX_API_KEY=your_sandbox_api_key_here
SANDBOX_API_SECRET=your_sandbox_api_secret_here
SANDBOX_API_VERSION=1.0.0
SANDBOX_BASE_URL=https://api.sandbox.co.in

# Sarvam AI API Credentials (STT, TTS, Indic Translation §3)
# Models: Saaras/Saarika (STT), Bulbul (TTS), Mayura (Translation)
# Get key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_BASE_URL=https://api.sarvam.ai

# Vision LLM & Text LLM Credentials (§2)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. Microservice Endpoints
# ------------------------------------------------------------------------------
# Mock GST Enrollment ID Service (§5)
MOCK_ENROLLMENT_SERVICE_URL=http://localhost:4000

# Standalone React GST Enrollment Demo App (Port 5173 redirect flow)
GST_DEMO_APP_URL=http://localhost:5173
