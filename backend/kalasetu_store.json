        "bn": "\u09ac\u09b8\u09cd\u09a4\u09be\u09b0 \u0986\u09a6\u09bf\u09ac\u09be\u09b8\u09c0 \u09a2\u09cb\u0995\u09b0\u09be \u09aa\u09bf\u09a4\u09b2\u09c7\u09b0 \u09b8\u0999\u09cd\u0997\u09c0\u09a4\u09b6\u09bf\u09b2\u09cd\u09aa\u09c0 \u09ae\u09c2\u09b0\u09cd\u09a4\u09bf",
        "mr": "\u092c\u0938\u094d\u0924\u0930 \u0906\u0926\u093f\u0935\u093e\u0938\u0940 \u0922\u094b\u0915\u0930\u093e \u092a\u093f\u0924\u0933\u0940 \u0938\u0902\u0917\u0940\u0924\u0915\u093e\u0930 \u092e\u0942\u0930\u094d\u0924\u0940",
