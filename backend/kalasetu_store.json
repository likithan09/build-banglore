      "artisan_id": "usr_9876543210_101",
      "artisan_name": "Ramprasad Bunkar",
      "artisan_location": "Varanasi, Uttar Pradesh",
      "title": "Handwoven Banarasi Katan Silk Saree with Zari Motifs",
      "title_translations": {
        "hi": "\u0939\u0938\u094d\u0924\u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u092c\u0928\u093e\u0930\u0938\u0940 \u0915\u0924\u093e\u0928 \u0938\u093f\u0932\u094d\u0915 \u0938\u093e\u0921\u093c\u0940 \u091c\u093c\u0930\u0940 \u0935\u0930\u094d\u0915 \u0915\u0947 \u0938\u093e\u0925",
        "ta": "\u0b95\u0bc8\u0baf\u0bbe\u0bb2\u0bcd \u0ba8\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0baa\u0ba9\u0bbe\u0bb0\u0b9a\u0bbf \u0b95\u0b9f\u0bcd\u0b9f\u0bbe\u0ba9\u0bcd \u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0bc1\u0b9f\u0bb5\u0bc8 \u0b9c\u0bb0\u0bbf \u0bb5\u0bc7\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0bbe\u0b9f\u0bc1\u0b9f\u0ba9\u0bcd",
        "te": "\u0c1c\u0c30\u0c40 \u0c2e\u0c42\u0c32\u0c3e\u0c02\u0c36\u0c3e\u0c32\u0c24\u0c4b \u0c1a\u0c47\u0c24\u0c3f\u0c24\u0c4b \u0c28\u0c47\u0c38\u0c3f\u0c28 \u0c2c\u0c28\u0c3e\u0c30\u0c38\u0c3f \u0c15\u0c3e\u0c1f\u0c28\u0c4d \u0c2a\u0c1f\u0c4d\u0c1f\u0c41 \u0c1a\u0c40\u0c30",
        "bn": "\u099c\u09b0\u09bf\u09b0 \u0995\u09be\u09b0\u09c1\u0995\u09be\u099c \u09b8\u09b9 \u09b9\u09b8\u09cd\u09a4\u09a8\u09bf\u09b0\u09cd\u09ae\u09bf\u09a4 \u09ac\u09c7\u09a8\u09be\u09b0\u09b8\u09bf \u0995\u09be\u09a4\u09be\u09a8 \u09b0\u09c7\u09b6\u09ae \u09b6\u09be\u09a1\u09bc\u09bf",
        "mr": "\u091c\u0930\u0940\u091a\u094d\u092f\u093e \u0915\u093e\u092e\u093e\u0938\u0939 \u0939\u093e\u0924\u093e\u0928\u0947 \u0935\u093f\u0923\u0932\u0947\u0932\u0940 \u092c\u0928\u093e\u0930\u0938\u0940 \u0915\u093e\u0924\u093e\u0928 \u0930\u0947\u0936\u0940\u092e \u0938\u093e\u0921\u0940",
        "gu": "\u0a9d\u0ab0\u0ac0 \u0ab5\u0ab0\u0acd\u0a95 \u0ab8\u0abe\u0aa5\u0ac7 \u0ab9\u0abe\u0aa5\u0aa5\u0ac0 \u0ab5\u0aa3\u0ac7\u0ab2\u0ac0 \u0aac\u0aa8\u0abe\u0ab0\u0ab8\u0ac0 \u0a95\u0abe\u0aa4\u0abe\u0aa8 \u0ab8\u0abf\u0ab2\u0acd\u0a95 \u0ab8\u0abe\u0aa1\u0ac0",
        "kn": "\u0c9c\u0cb0\u0cbf \u0cae\u0ccb\u0c9f\u0cbf\u0cab\u0ccd\u200c\u0c97\u0cb3\u0cca\u0c82\u0ca6\u0cbf\u0c97\u0cc6 \u0c95\u0cc8\u0caf\u0cbf\u0c82\u0ca6 \u0ca8\u0cc7\u0caf\u0ccd\u0ca6 \u0cac\u0ca8\u0cbe\u0cb0\u0cb8\u0cbf \u0c95\u0c9f\u0cbe\u0ca8\u0ccd \u0cb0\u0cc7\u0cb7\u0ccd\u0cae\u0cc6 \u0cb8\u0cc0\u0cb0\u0cc6",
        "ml": "\u0d38\u0d30\u0d3f \u0d35\u0d7c\u0d15\u0d4d\u0d15\u0d41\u0d33\u0d4d\u0d33 \u0d15\u0d48\u0d24\u0d4d\u0d24\u0d31\u0d3f \u0d2c\u0d28\u0d3e\u0d31\u0d38\u0d3f \u0d15\u0d3e\u0d31\u0d4d\u0d31\u0d7b \u0d38\u0d3f\u0d7d\u0d15\u0d4d\u0d15\u0d4d \u0d38\u0d3e\u0d30\u0d3f",
        "or": "\u0b1c\u0b30\u0b40 \u0b15\u0b3e\u0b2e \u0b38\u0b39\u0b3f\u0b24 \u0b39\u0b38\u0b4d\u0b24\u0b24\u0b28\u0b4d\u0b24 \u0b2c\u0b28\u0b3e\u0b30\u0b38\u0b40 \u0b15\u0b3e\u0b24\u0b3e\u0b28 \u0b30\u0b47\u0b36\u0b2e \u0b36\u0b3e\u0b22\u0b3c\u0b40",
        "pa": "\u0a1c\u0a3c\u0a30\u0a40 \u0a26\u0a47 \u0a15\u0a70\u0a2e \u0a28\u0a3e\u0a32 \u0a39\u0a71\u0a25 \u0a28\u0a3e\u0a32 \u0a2c\u0a23\u0a40 \u0a2c\u0a28\u0a3e\u0a30\u0a38\u0a40 \u0a15\u0a3e\u0a24\u0a3e\u0a28 \u0a30\u0a47\u0a38\u0a3c\u0a2e \u0a38\u0a3e\u0a5c\u0a40"
      },
      "description": "Exquisite pure mulberry silk saree handwoven on traditional pit looms taking 24 days of dedicated master craftsmanship. Features Mughal floral jaal with tested gold-silver zari.",
      "description_translations": {
        "hi": "\u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0917\u0921\u094d\u0922\u093e \u0915\u0930\u0918\u094b\u0902 \u092a\u0930 24 \u0926\u093f\u0928\u094b\u0902 \u0915\u0940 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u092e\u093e\u0938\u094d\u091f\u0930 \u0915\u093e\u0930\u0940\u0917\u0930\u0940 \u0938\u0947 \u092c\u0941\u0928\u0940 \u0917\u0908 \u0936\u0941\u0926\u094d\u0927 \u0936\u0939\u0924\u0942\u0924 \u0930\u0947\u0936\u092e \u0938\u093e\u0921\u093c\u0940\u0964 \u0938\u094b\u0928\u0947-\u091a\u093e\u0902\u0926\u0940 \u0915\u0940 \u091c\u093c\u0930\u0940 \u0915\u093e \u092e\u0941\u0917\u0932 \u092b\u094d\u0932\u094b\u0930\u0932 \u091c\u093e\u0932\u0964",
        "ta": "\u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0baa\u0bbf\u0b9f\u0bcd \u0ba4\u0bb1\u0bbf\u0b95\u0bb3\u0bbf\u0bb2\u0bcd 24 \u0ba8\u0bbe\u0b9f\u0bcd\u0b95\u0bb3\u0bcd \u0ba8\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0ba4\u0bc2\u0baf \u0bae\u0bb2\u0bcd\u0baa\u0bc6\u0bb0\u0bbf \u0baa\u0b9f\u0bcd\u0b9f\u0bc1 \u0baa\u0bc1\u0b9f\u0bb5\u0bc8.",
        "te": "\u0c38\u0c3e\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c2f \u0c17\u0c41\u0c02\u0c24 \u0c2e\u0c17\u0c4d\u0c17\u0c3e\u0c32\u0c2a\u0c48 24 \u0c30\u0c4b\u0c1c\u0c41\u0c32 \u0c36\u0c4d\u0c30\u0c2e\u0c24\u0c4b \u0c28\u0c47\u0c38\u0c3f\u0c28 \u0c38\u0c4d\u0c35\u0c1a\u0c4d\u0c1b\u0c2e\u0c48\u0c28 \u0c2e\u0c32\u0c4d\u0c2c\u0c30\u0c40 \u0c2a\u0c1f\u0c4d\u0c1f\u0c41 \u0c1a\u0c40\u0c30.",
        "bn": "\u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09aa\u09bf\u099f \u09a4\u09be\u0981\u09a4\u09c7 \u09e8\u09ea \u09a6\u09bf\u09a8\u09c7\u09b0 \u09b6\u09cd\u09b0\u09ae\u09c7 \u09ac\u09cb\u09a8\u09be \u0996\u09be\u0981\u099f\u09bf \u09a4\u09c1\u0981\u09a4 \u09b0\u09c7\u09b6\u09ae\u09c7\u09b0 \u09b6\u09be\u09a1\u09bc\u09bf\u0964",
        "mr": "\u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u0916\u0921\u094d\u0921\u093e \u092e\u093e\u0917\u093e\u0935\u0930 \u0968\u096a \u0926\u093f\u0935\u0938 \u0935\u093f\u0923\u0932\u0947\u0932\u0940 \u0936\u0941\u0926\u094d\u0927 \u092e\u0932\u092c\u0947\u0930\u0940 \u0930\u0947\u0936\u0940\u092e \u0938\u093e\u0921\u0940.",
        "gu": "\u0aaa\u0ab0\u0a82\u0aaa\u0ab0\u0abe\u0a97\u0aa4 \u0a96\u0abe\u0aa1\u0abe \u0ab8\u0abe\u0ab3 \u0aaa\u0ab0 24 \u0aa6\u0abf\u0ab5\u0ab8\u0aa8\u0ac0 \u0aae\u0ab9\u0ac7\u0aa8\u0aa4\u0aa5\u0ac0 \u0ab5\u0aa3\u0ac7\u0ab2\u0ac0 \u0ab6\u0ac1\u0aa6\u0acd\u0aa7 \u0ab6\u0ac7\u0aa4\u0ac2\u0ab0 \u0ab8\u0abf\u0ab2\u0acd\u0a95 \u0ab8\u0abe\u0aa1\u0ac0.",
        "kn": "\u0cb8\u0cbe\u0c82\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0cbf\u0c95 \u0cae\u0c97\u0ccd\u0c97\u0c97\u0cb3\u0cb2\u0ccd\u0cb2\u0cbf 24 \u0ca6\u0cbf\u0ca8\u0c97\u0cb3 \u0cb6\u0ccd\u0cb0\u0cae\u0ca6\u0cbf\u0c82\u0ca6 \u0ca8\u0cc7\u0caf\u0ccd\u0ca6 \u0cb6\u0cc1\u0ca6\u0ccd\u0ca7 \u0cae\u0cb2\u0ccd\u0cac\u0cb0\u0cbf \u0cb0\u0cc7\u0cb7\u0ccd\u0cae\u0cc6 \u0cb8\u0cc0\u0cb0\u0cc6.",
        "ml": "\u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3e\u0d17\u0d24 \u0d24\u0d31\u0d3f\u0d15\u0d33\u0d3f\u0d7d 24 \u0d26\u0d3f\u0d35\u0d38\u0d24\u0d4d\u0d24\u0d46 \u0d05\u0d27\u0d4d\u0d35\u0d3e\u0d28\u0d24\u0d4d\u0d24\u0d3f\u0d7d \u0d28\u0d46\u0d2f\u0d4d\u0d24 \u0d36\u0d41\u0d26\u0d4d\u0d27\u0d2e\u0d3e\u0d2f \u0d2a\u0d1f\u0d4d\u0d1f\u0d4d \u0d38\u0d3e\u0d30\u0d3f.",
        "or": "\u0b2a\u0b3e\u0b30\u0b2e\u0b4d\u0b2a\u0b30\u0b3f\u0b15 \u0b24\u0b28\u0b4d\u0b24\u0b30\u0b47 \u0b68\u0b6a \u0b26\u0b3f\u0b28\u0b30 \u0b2a\u0b30\u0b3f\u0b36\u0b4d\u0b30\u0b2e\u0b30\u0b47 \u0b2c\u0b41\u0b23\u0b3e\u0b2f\u0b3e\u0b07\u0b25\u0b3f\u0b2c\u0b3e \u0b36\u0b41\u0b26\u0b4d\u0b27 \u0b30\u0b47\u0b36\u0b2e \u0b36\u0b3e\u0b22\u0b3c\u0b40\u0964",
        "pa": "\u0a30\u0a35\u0a3e\u0a07\u0a24\u0a40 \u0a16\u0a71\u0a21\u0a40\u0a06\u0a02 '\u0a24\u0a47 24 \u0a26\u0a3f\u0a28\u0a3e\u0a02 \u0a26\u0a40 \u0a2e\u0a3f\u0a39\u0a28\u0a24 \u0a28\u0a3e\u0a32 \u0a24\u0a3f\u0a06\u0a30 \u0a15\u0a40\u0a24\u0a40 \u0a17\u0a08 \u0a38\u0a3c\u0a41\u0a71\u0a27 \u0a30\u0a47\u0a38\u0a3c\u0a2e \u0a38\u0a3e\u0a5c\u0a40\u0964"
      },
      "cultural_story": "Our family in Madanpura, Varanasi has preserved the Kadwa weave technique across five generations. Each lotus motif requires separate spools manipulated entirely by hand without loose threads on the reverse.",
      "category": "Textiles & Handlooms",
      "craft_technique": "Kadwa Pit Loom Weaving",
