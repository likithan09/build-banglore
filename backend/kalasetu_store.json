        "kn": "\u0cac\u0cb8\u0ccd\u0ca4\u0cbe\u0cb0\u0ccd \u0cac\u0cc1\u0ca1\u0c95\u0c9f\u0ccd\u0c9f\u0cc1 \u0ca1\u0ccb\u0c95\u0ccd\u0cb0\u0cbe \u0cb9\u0cbf\u0ca4\u0ccd\u0ca4\u0cbe\u0cb3\u0cc6 \u0cae\u0cc2\u0cb0\u0ccd\u0ca4\u0cbf",
        "ml": "\u0d2c\u0d38\u0d4d\u0d24\u0d7c \u0d06\u0d26\u0d3f\u0d35\u0d3e\u0d38\u0d3f \u0d27\u0d4b\u0d15\u0d4d\u0d30 \u0d2a\u0d3f\u0d1a\u0d4d\u0d1a\u0d33 \u0d38\u0d02\u0d17\u0d40\u0d24\u0d1c\u0d4d\u0d1e \u0d2a\u0d4d\u0d30\u0d24\u0d3f\u0d2e",
        "or": "\u0b2c\u0b38\u0b4d\u0b24\u0b30 \u0b06\u0b26\u0b3f\u0b2c\u0b3e\u0b38\u0b40 \u0b22\u0b4b\u0b15\u0b4d\u0b30\u0b3e \u0b2a\u0b3f\u0b24\u0b4d\u0b24\u0b33 \u0b38\u0b19\u0b4d\u0b17\u0b40\u0b24\u0b15\u0b3e\u0b30 \u0b2e\u0b42\u0b30\u0b4d\u0b24\u0b4d\u0b24\u0b3f",
        "pa": "\u0a2c\u0a38\u0a24\u0a30 \u0a06\u0a26\u0a3f\u0a35\u0a3e\u0a38\u0a40 \u0a22\u0a4b\u0a15\u0a30\u0a3e \u0a2a\u0a3f\u0a71\u0a24\u0a32 \u0a38\u0a70\u0a17\u0a40\u0a24\u0a15\u0a3e\u0a30 \u0a2e\u0a42\u0a30\u0a24\u0a40"
      },
