    "prod_2": {
      "id": "prod_2",
      "artisan_id": "usr_9876543211_102",
      "artisan_name": "Sita Devi & Sunita Kumari",
      "artisan_location": "Madhubani, Bihar",
      "title": "Tree of Life Original Madhubani Painting on Handmade Paper",
      "title_translations": {
        "hi": "\u0939\u0938\u094d\u0924\u0928\u093f\u0930\u094d\u092e\u093f\u0924 \u0915\u093e\u0917\u091c\u093c \u092a\u0930 \u0915\u0932\u094d\u092a\u0935\u0943\u0915\u094d\u0937 (\u091f\u094d\u0930\u0940 \u0911\u092b\u093c \u0932\u093e\u0907\u092b) \u092e\u0927\u0941\u092c\u0928\u0940 \u092a\u0947\u0902\u091f\u093f\u0902\u0917",
        "ta": "\u0b95\u0bc8\u0bb5\u0bbf\u0ba9\u0bc8 \u0b95\u0bbe\u0b95\u0bbf\u0ba4\u0ba4\u0bcd\u0ba4\u0bbf\u0bb2\u0bcd \u0b85\u0b9a\u0bb2\u0bcd \u0bae\u0ba4\u0bc1\u0baa\u0bbe\u0ba9\u0bbf \u0b93\u0bb5\u0bbf\u0baf\u0bae\u0bcd (\u0b9c\u0bc0\u0bb5 \u0bb5\u0bbf\u0bb0\u0bc1\u0b9f\u0bcd\u0b9a\u0bae\u0bcd)",
        "te": "\u0c1a\u0c47\u0c24\u0c3f\u0c24\u0c4b \u0c24\u0c2f\u0c3e\u0c30\u0c41 \u0c1a\u0c47\u0c38\u0c3f\u0c28 \u0c15\u0c3e\u0c17\u0c3f\u0c24\u0c02\u0c2a\u0c48 \u0c12\u0c30\u0c3f\u0c1c\u0c3f\u0c28\u0c32\u0c4d \u0c2e\u0c27\u0c41\u0c2c\u0c28\u0c3f \u0c2a\u0c46\u0c2f\u0c3f\u0c02\u0c1f\u0c3f\u0c02\u0c17\u0c4d",
        "bn": "\u09b9\u09be\u09a4\u09c7 \u09a4\u09c8\u09b0\u09bf \u0995\u09be\u0997\u099c\u09c7 \u0995\u09b2\u09cd\u09aa\u09ac\u09c3\u0995\u09cd\u09b7 \u09ae\u09cc\u09b2\u09bf\u0995 \u09ae\u09a7\u09c1\u09ac\u09a8\u09c0 \u099a\u09bf\u09a4\u09cd\u09b0\u09b6\u09bf\u09b2\u09cd\u09aa",
        "mr": "\u0939\u093e\u0924\u093e\u0928\u0947 \u0924\u092f\u093e\u0930 \u0915\u0947\u0932\u0947\u0932\u094d\u092f\u093e \u0915\u093e\u0917\u0926\u093e\u0935\u0930 \u092e\u0942\u0933 \u092e\u0927\u0941\u092c\u0928\u0940 \u091a\u093f\u0924\u094d\u0930\u0915\u0932\u093e",
        "gu": "\u0ab9\u0abe\u0aa5\u0aa5\u0ac0 \u0aac\u0aa8\u0abe\u0ab5\u0ac7\u0ab2\u0abe \u0a95\u0abe\u0a97\u0ab3 \u0aaa\u0ab0 \u0a95\u0ab2\u0acd\u0aaa\u0ab5\u0ac3\u0a95\u0acd\u0ab7 \u0aae\u0ac2\u0ab3 \u0aae\u0aa7\u0ac1\u0aac\u0aa8\u0ac0 \u0aaa\u0ac7\u0a87\u0aa8\u0acd\u0a9f\u0abf\u0a82\u0a97",
        "kn": "\u0c95\u0cc8\u0caf\u0cbf\u0c82\u0ca6 \u0cae\u0cbe\u0ca1\u0cbf\u0ca6 \u0c95\u0cbe\u0c97\u0ca6\u0ca6 \u0cae\u0cc7\u0cb2\u0cc6 \u0cae\u0cc2\u0cb2 \u0cae\u0ca7\u0cc1\u0cac\u0ca8\u0cbf \u0c9a\u0cbf\u0ca4\u0ccd\u0cb0\u0c95\u0cb2\u0cc6",
        "ml": "\u0d15\u0d48\u0d15\u0d4a\u0d23\u0d4d\u0d1f\u0d4d \u0d28\u0d3f\u0d7c\u0d2e\u0d4d\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a \u0d2a\u0d47\u0d2a\u0d4d\u0d2a\u0d31\u0d3f\u0d7d \u0d2f\u0d25\u0d3e\u0d7c\u0d24\u0d4d\u0d25 \u0d2e\u0d27\u0d41\u0d2c\u0d3e\u0d28\u0d3f \u0d2a\u0d46\u0d2f\u0d3f\u0d28\u0d4d\u0d31\u0d3f\u0d02\u0d17\u0d4d",
        "or": "\u0b39\u0b38\u0b4d\u0b24\u0b28\u0b3f\u0b30\u0b4d\u0b2e\u0b3f\u0b24 \u0b15\u0b3e\u0b17\u0b1c\u0b30\u0b47 \u0b15\u0b33\u0b4d\u0b2a\u0b2c\u0b43\u0b15\u0b4d\u0b37 \u0b2e\u0b42\u0b33 \u0b2e\u0b27\u0b41\u0b2c\u0b28\u0b40 \u0b1a\u0b3f\u0b24\u0b4d\u0b30\u0b15\u0b33\u0b3e",
        "pa": "\u0a39\u0a71\u0a25 \u0a28\u0a3e\u0a32 \u0a2c\u0a23\u0a47 \u0a15\u0a3e\u0a17\u0a1c\u0a3c '\u0a24\u0a47 \u0a05\u0a38\u0a32 \u0a2e\u0a27\u0a42\u0a2c\u0a28\u0a40 \u0a2a\u0a47\u0a02\u0a1f\u0a3f\u0a70\u0a17"
      },
      "description": "Authentic Mithila Kohbar artwork hand-painted using bamboo twigs, nib pens, and 100% organic forest dyes made from turmeric, soot, indigo, and aparajita flowers.",
      "description_translations": {
        "hi": "\u092c\u093e\u0902\u0938 \u0915\u0940 \u0924\u0940\u0932\u093f\u092f\u094b\u0902 \u0914\u0930 \u0939\u0932\u094d\u0926\u0940, \u0928\u0940\u0932, \u0915\u093e\u091c\u0932 \u0914\u0930 \u0905\u092a\u0930\u093e\u091c\u093f\u0924\u093e \u0915\u0947 100% \u092a\u094d\u0930\u093e\u0915\u0943\u0924\u093f\u0915 \u0930\u0902\u0917\u094b\u0902 \u0938\u0947 \u0939\u093e\u0925 \u0938\u0947 \u092c\u0928\u093e\u0908 \u0917\u0908 \u092a\u094d\u0930\u093e\u092e\u093e\u0923\u093f\u0915 \u092e\u093f\u0925\u093f\u0932\u093e \u0915\u0932\u093e\u0915\u0943\u0924\u093f\u0964",
        "ta": "\u0bae\u0bc2\u0b99\u0bcd\u0b95\u0bbf\u0bb2\u0bcd \u0b95\u0bc1\u0b9a\u0bcd\u0b9a\u0bbf\u0b95\u0bb3\u0bcd \u0bae\u0bb1\u0bcd\u0bb1\u0bc1\u0bae\u0bcd \u0b87\u0baf\u0bb1\u0bcd\u0b95\u0bc8 \u0bae\u0bc2\u0bb2\u0bbf\u0b95\u0bc8 \u0bb5\u0ba3\u0bcd\u0ba3\u0b99\u0bcd\u0b95\u0bb3\u0bbe\u0bb2\u0bcd \u0bb5\u0bb0\u0bc8\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0bae\u0bbf\u0ba4\u0bbf\u0bb2\u0bbe \u0b95\u0bb2\u0bc8\u0baa\u0bcd\u0baa\u0b9f\u0bc8\u0baa\u0bcd\u0baa\u0bc1.",
        "te": "\u0c35\u0c46\u0c26\u0c41\u0c30\u0c41 \u0c2a\u0c41\u0c32\u0c4d\u0c32\u0c32\u0c41 \u0c2e\u0c30\u0c3f\u0c2f\u0c41 \u0c38\u0c39\u0c1c \u0c30\u0c02\u0c17\u0c41\u0c32\u0c24\u0c4b \u0c17\u0c40\u0c38\u0c3f\u0c28 \u0c2a\u0c4d\u0c30\u0c3e\u0c2e\u0c3e\u0c23\u0c3f\u0c15 \u0c2e\u0c3f\u0c25\u0c3f\u0c32 \u0c15\u0c33\u0c3e\u0c16\u0c02\u0c21\u0c02.",
        "bn": "\u09ac\u09be\u0981\u09b6\u09c7\u09b0 \u0995\u09be\u09a0\u09bf \u0993 \u09aa\u09cd\u09b0\u09be\u0995\u09c3\u09a4\u09bf\u0995 \u09b0\u0999\u09c7\u09b0 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af\u09c7 \u0986\u0981\u0995\u09be \u0996\u09be\u0981\u099f\u09bf \u09ae\u09bf\u09a5\u09bf\u09b2\u09be \u099a\u09bf\u09a4\u09cd\u09b0\u09b6\u09bf\u09b2\u09cd\u09aa\u0964",
        "mr": "\u092c\u093e\u0902\u092c\u0942\u091a\u094d\u092f\u093e \u0915\u093e\u0921\u094d\u092f\u093e \u0906\u0923\u093f \u0928\u0948\u0938\u0930\u094d\u0917\u093f\u0915 \u0930\u0902\u0917\u093e\u0902\u0928\u0940 \u0939\u093e\u0924\u093e\u0928\u0947 \u0930\u0947\u0916\u093e\u091f\u0932\u0947\u0932\u0940 \u0905\u0938\u094d\u0938\u0932 \u092e\u093f\u0925\u093f\u0932\u093e \u0915\u0932\u093e\u0915\u0943\u0924\u0940.",
        "gu": "\u0ab5\u0abe\u0a82\u0ab8\u0aa8\u0ac0 \u0ab8\u0ab3\u0ac0\u0a93 \u0a85\u0aa8\u0ac7 \u0a95\u0ac1\u0aa6\u0ab0\u0aa4\u0ac0 \u0ab0\u0a82\u0a97\u0acb\u0aa5\u0ac0 \u0ab9\u0abe\u0aa5\u0aa5\u0ac0 \u0aa6\u0acb\u0ab0\u0ac7\u0ab2\u0ac0 \u0a85\u0ab8\u0ab2 \u0aae\u0abf\u0aa5\u0abf\u0ab2\u0abe \u0a95\u0ab2\u0abe\u0a95\u0ac3\u0aa4\u0abf.",
        "kn": "\u0cac\u0cbf\u0ca6\u0cbf\u0cb0\u0cbf\u0ca8 \u0c95\u0ca1\u0ccd\u0ca1\u0cbf\u0c97\u0cb3\u0cc1 \u0cae\u0ca4\u0ccd\u0ca4\u0cc1 \u0ca8\u0cc8\u0cb8\u0cb0\u0ccd\u0c97\u0cbf\u0c95 \u0cac\u0ca3\u0ccd\u0ca3\u0c97\u0cb3\u0cbf\u0c82\u0ca6 \u0cb0\u0c9a\u0cbf\u0cb8\u0cb2\u0cbe\u0ca6 \u0c85\u0ca7\u0cbf\u0c95\u0cc3\u0ca4 \u0cae\u0cbf\u0ca5\u0cbf\u0cb2\u0cbe \u0c95\u0cb2\u0cc6.",
        "ml": "\u0d2e\u0d41\u0d33\u0d19\u0d4d\u0d15\u0d2e\u0d4d\u0d2a\u0d41\u0d15\u0d33\u0d41\u0d02 \u0d2a\u0d4d\u0d30\u0d15\u0d43\u0d24\u0d3f\u0d26\u0d24\u0d4d\u0d24 \u0d28\u0d3f\u0d31\u0d19\u0d4d\u0d19\u0d33\u0d41\u0d02 \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d35\u0d30\u0d1a\u0d4d\u0d1a \u0d2e\u0d3f\u0d25\u0d3f\u0d32\u0d3e \u0d1a\u0d3f\u0d24\u0d4d\u0d30\u0d15\u0d32.",
        "or": "\u0b2c\u0b3e\u0b09\u0b01\u0b36 \u0b15\u0b3e\u0b20\u0b3f \u0b0f\u0b2c\u0b02 \u0b2a\u0b4d\u0b30\u0b3e\u0b15\u0b43\u0b24\u0b3f\u0b15 \u0b30\u0b19\u0b4d\u0b17\u0b30\u0b47 \u0b05\u0b19\u0b4d\u0b15\u0b3f\u0b24 \u0b2a\u0b4d\u0b30\u0b3e\u0b2e\u0b3e\u0b23\u0b3f\u0b15 \u0b2e\u0b3f\u0b25\u0b3f\u0b33\u0b3e \u0b15\u0b33\u0b3e\u0b15\u0b43\u0b24\u0b3f\u0964",
        "pa": "\u0a2c\u0a3e\u0a02\u0a38 \u0a26\u0a40\u0a06\u0a02 \u0a24\u0a40\u0a32\u0a40\u0a06\u0a02 \u0a05\u0a24\u0a47 \u0a15\u0a41\u0a26\u0a30\u0a24\u0a40 \u0a30\u0a70\u0a17\u0a3e\u0a02 \u0a28\u0a3e\u0a32 \u0a39\u0a71\u0a25 \u0a28\u0a3e\u0a32 \u0a2c\u0a23\u0a3e\u0a08 \u0a17\u0a08 \u0a2e\u0a3f\u0a25\u0a3f\u0a32\u0a3e \u0a15\u0a32\u0a3e\u0964"
      },
