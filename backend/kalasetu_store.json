      "title": "Royal Turquoise Blue Pottery Floral Motif Urn Vase",
      "title_translations": {
        "hi": "\u0936\u093e\u0939\u0940 \u092b\u093f\u0930\u094b\u091c\u093c\u0940 \u092c\u094d\u0932\u0942 \u092a\u0949\u091f\u0930\u0940 \u0928\u0915\u094d\u0915\u093e\u0936\u0940\u0926\u093e\u0930 \u0915\u0932\u0936 \u0917\u0941\u0932\u0926\u0938\u094d\u0924\u093e",
        "ta": "\u0bb0\u0bbe\u0baf\u0bb2\u0bcd \u0b9f\u0bb0\u0bcd\u0b95\u0bcd\u0b95\u0bbe\u0baf\u0bcd\u0bb8\u0bcd \u0ba8\u0bc0\u0bb2 \u0bae\u0ba3\u0bcd\u0baa\u0bbe\u0ba3\u0bcd\u0b9f \u0bae\u0bb2\u0bb0\u0bcd \u0bb5\u0b9f\u0bbf\u0bb5 \u0b95\u0bc1\u0bb5\u0bb3\u0bc8",
        "te": "\u0c30\u0c3e\u0c2f\u0c32\u0c4d \u0c1f\u0c30\u0c4d\u0c15\u0c4b\u0c2f\u0c3f\u0c38\u0c4d \u0c2c\u0c4d\u0c32\u0c42 \u0c15\u0c41\u0c02\u0c21\u0c32 \u0c2a\u0c42\u0c32 \u0c1c\u0c3e\u0c21\u0c40",
        "bn": "\u09b0\u09be\u099c\u0995\u09c0\u09af\u09bc \u09ab\u09bf\u09b0\u09cb\u099c\u09be \u09ac\u09cd\u09b2\u09c1 \u09aa\u099f\u09be\u09b0\u09bf \u09ab\u09c1\u09b2\u09a6\u09be\u09a8\u09bf",
        "mr": "\u0936\u093e\u0939\u0940 \u092b\u093f\u0930\u094b\u091c\u0940 \u092c\u094d\u0932\u0942 \u092a\u0949\u091f\u0930\u0940 \u0928\u0915\u094d\u0937\u0940\u0926\u093e\u0930 \u092b\u0941\u0932\u0926\u093e\u0923\u0940",
        "gu": "\u0ab6\u0abe\u0ab9\u0ac0 \u0aab\u0abf\u0ab0\u0acb\u0a9d\u0ac0 \u0aac\u0acd\u0ab2\u0ac1 \u0aaa\u0acb\u0a9f\u0ab0\u0ac0 \u0aab\u0acd\u0ab2\u0abe\u0ab5\u0ab0 \u0ab5\u0abe\u0a9d",
        "kn": "\u0cb0\u0cbe\u0caf\u0cb2\u0ccd \u0cb5\u0cc8\u0ca1\u0cc2\u0cb0\u0ccd\u0caf \u0cac\u0ccd\u0cb2\u0cc2 \u0caa\u0cbe\u0c9f\u0cb0\u0cbf \u0cb9\u0cc2\u0ca6\u0cbe\u0ca8\u0cbf",
        "ml": "\u0d31\u0d4b\u0d2f\u0d7d \u0d1f\u0d7c\u0d15\u0d4d\u0d15\u0d4b\u0d2f\u0d4d\u0d38\u0d4d \u0d2c\u0d4d\u0d32\u0d42 \u0d2a\u0d4b\u0d1f\u0d4d\u0d1f\u0d31\u0d3f \u0d2a\u0d42\u0d2a\u0d4d\u0d2a\u0d3e\u0d24\u0d4d\u0d30\u0d02",
        "or": "\u0b30\u0b3e\u0b1c\u0b15\u0b40\u0b5f \u0b2b\u0b3f\u0b30\u0b4b\u0b1c\u0b3e \u0b2c\u0b4d\u0b32\u0b41 \u0b2a\u0b1f\u0b47\u0b30\u0b40 \u0b2b\u0b41\u0b32\u0b26\u0b3e\u0b28\u0b40",
        "pa": "\u0a38\u0a3c\u0a3e\u0a39\u0a40 \u0a2b\u0a3f\u0a30\u0a4b\u0a1c\u0a3c\u0a40 \u0a2c\u0a32\u0a42 \u0a2a\u0a4b\u0a1f\u0a30\u0a40 \u0a2b\u0a41\u0a71\u0a32\u0a26\u0a3e\u0a28"
      },
      "description": "Dough-cast Egyptian blue glazed ceramic vase made without clay using quartz powder, Fuller's earth, and copper oxide pigment. Fired in wood kilns at 850\u00b0C.",
      "description_translations": {
        "hi": "\u0915\u094d\u0935\u093e\u0930\u094d\u091f\u094d\u091c \u092a\u093e\u0909\u0921\u0930, \u092e\u0941\u0932\u094d\u0924\u093e\u0928\u0940 \u092e\u093f\u091f\u094d\u091f\u0940 \u0914\u0930 \u0915\u0949\u092a\u0930 \u0911\u0915\u094d\u0938\u093e\u0907\u0921 \u0938\u0947 \u092c\u093f\u0928\u093e \u092e\u093f\u091f\u094d\u091f\u0940 \u0915\u0947 \u092c\u0928\u093e\u0908 \u0917\u0908 \u092a\u093e\u0930\u0902\u092a\u0930\u093f\u0915 \u092b\u093f\u0930\u094b\u091c\u093c\u0940 \u091a\u0940\u0928\u0940 \u092e\u093f\u091f\u094d\u091f\u0940 \u0915\u0940 \u0915\u0932\u093e\u0915\u0943\u0924\u093f\u0964",
        "ta": "\u0b95\u0bb3\u0bbf\u0bae\u0ba3\u0bcd \u0baa\u0baf\u0ba9\u0bcd\u0baa\u0b9f\u0bc1\u0ba4\u0bcd\u0ba4\u0bbe\u0bae\u0bb2\u0bcd \u0b95\u0bc1\u0bb5\u0bbe\u0bb0\u0bcd\u0b9f\u0bcd\u0bb8\u0bcd \u0baa\u0bca\u0b9f\u0bbf\u0baf\u0bbe\u0bb2\u0bcd \u0b9a\u0bc6\u0baf\u0bcd\u0baf\u0baa\u0bcd\u0baa\u0b9f\u0bcd\u0b9f \u0b9c\u0bc6\u0baf\u0bcd\u0baa\u0bcd\u0baa\u0bc2\u0bb0\u0bcd \u0baa\u0bbe\u0bb0\u0bae\u0bcd\u0baa\u0bb0\u0bbf\u0baf \u0ba8\u0bc0\u0bb2 \u0bae\u0ba3\u0bcd\u0baa\u0bbe\u0ba3\u0bcd\u0b9f\u0bae\u0bcd.",
        "te": "\u0c2e\u0c1f\u0c4d\u0c1f\u0c3f \u0c32\u0c47\u0c15\u0c41\u0c02\u0c21\u0c3e \u0c15\u0c4d\u0c35\u0c3e\u0c30\u0c4d\u0c1f\u0c4d\u0c1c\u0c4d \u0c2a\u0c4a\u0c21\u0c3f\u0c24\u0c4b \u0c24\u0c2f\u0c3e\u0c30\u0c41 \u0c1a\u0c47\u0c2f\u0c2c\u0c21\u0c3f\u0c28 \u0c1c\u0c48\u0c2a\u0c42\u0c30\u0c4d \u0c38\u0c3e\u0c02\u0c2a\u0c4d\u0c30\u0c26\u0c3e\u0c2f \u0c28\u0c40\u0c32\u0c3f \u0c15\u0c41\u0c02\u0c21\u0c32 \u0c15\u0c33.",
        "bn": "\u09ae\u09be\u099f\u09bf \u099b\u09be\u09a1\u09bc\u09be \u0995\u09cb\u09af\u09bc\u09be\u09b0\u09cd\u099f\u099c \u09aa\u09be\u0989\u09a1\u09be\u09b0 \u09a6\u09bf\u09af\u09bc\u09c7 \u09a4\u09c8\u09b0\u09bf \u099c\u09af\u09bc\u09aa\u09c1\u09b0\u09c7\u09b0 \u0990\u09a4\u09bf\u09b9\u09cd\u09af\u09ac\u09be\u09b9\u09c0 \u09a8\u09c0\u09b2 \u09ae\u09c3\u09ce\u09b6\u09bf\u09b2\u09cd\u09aa\u0964",
        "mr": "\u092e\u093e\u0924\u0940\u0936\u093f\u0935\u093e\u092f \u0915\u094d\u0935\u093e\u0930\u094d\u091f\u094d\u091c \u092a\u093e\u0935\u0921\u0930\u092a\u093e\u0938\u0942\u0928 \u092c\u0928\u0935\u0932\u0947\u0932\u0940 \u091c\u092f\u092a\u0942\u0930\u091a\u0940 \u092a\u093e\u0930\u0902\u092a\u093e\u0930\u093f\u0915 \u0928\u093f\u0933\u0940 \u092e\u093e\u0924\u0940\u091a\u0940 \u0915\u0932\u093e\u0915\u0943\u0924\u0940.",
        "gu": "\u0aae\u0abe\u0a9f\u0ac0 \u0ab5\u0abf\u0aa8\u0abe \u0a95\u0acd\u0ab5\u0abe\u0ab0\u0acd\u0a9f\u0acd\u0a9d \u0aaa\u0abe\u0ab5\u0aa1\u0ab0\u0aa5\u0ac0 \u0aac\u0aa8\u0abe\u0ab5\u0ac7\u0ab2\u0ac0 \u0a9c\u0aaf\u0aaa\u0ac1\u0ab0\u0aa8\u0ac0 \u0aaa\u0ab0\u0a82\u0aaa\u0ab0\u0abe\u0a97\u0aa4 \u0ab5\u0abe\u0aa6\u0ab3\u0ac0 \u0aae\u0abe\u0a9f\u0ac0\u0a95\u0abe\u0aae \u0a95\u0ab3\u0abe.",
        "kn": "\u0c9c\u0cc7\u0ca1\u0cbf\u0cae\u0ca3\u0ccd\u0ca3\u0cbf\u0cb2\u0ccd\u0cb2\u0ca6\u0cc6 \u0cb8\u0ccd\u0cab\u0c9f\u0cbf\u0c95\u0ca6 \u0caa\u0cc1\u0ca1\u0cbf\u0caf\u0cbf\u0c82\u0ca6 \u0ca4\u0caf\u0cbe\u0cb0\u0cbf\u0cb8\u0cbf\u0ca6 \u0c9c\u0cc8\u0caa\u0cc1\u0cb0\u0ca6 \u0cb8\u0cbe\u0c82\u0caa\u0ccd\u0cb0\u0ca6\u0cbe\u0caf\u0cbf\u0c95 \u0ca8\u0cc0\u0cb2\u0cbf \u0cae\u0ca1\u0c95\u0cc6 \u0c95\u0cb2\u0cc6.",
        "ml": "\u0d15\u0d4d\u0d35\u0d3e\u0d7c\u0d1f\u0d4d\u0d38\u0d4d \u0d2a\u0d4a\u0d1f\u0d3f \u0d09\u0d2a\u0d2f\u0d4b\u0d17\u0d3f\u0d1a\u0d4d\u0d1a\u0d4d \u0d28\u0d3f\u0d7c\u0d2e\u0d4d\u0d2e\u0d3f\u0d1a\u0d4d\u0d1a \u0d1c\u0d2f\u0d4d\u0d2a\u0d42\u0d7c \u0d2a\u0d30\u0d2e\u0d4d\u0d2a\u0d30\u0d3e\u0d17\u0d24 \u0d28\u0d40\u0d32 \u0d2e\u0d7a\u0d2a\u0d3e\u0d24\u0d4d\u0d30\u0d02.",
        "or": "\u0b2e\u0b3e\u0b1f\u0b3f \u0b2c\u0b3f\u0b28\u0b3e \u0b15\u0b4d\u0b71\u0b3e\u0b30\u0b4d\u0b1f\u0b1c \u0b2a\u0b3e\u0b09\u0b21\u0b30\u0b30\u0b47 \u0b24\u0b3f\u0b06\u0b30\u0b3f \u0b1c\u0b5f\u0b2a\u0b41\u0b30\u0b30 \u0b2a\u0b3e\u0b30\u0b2e\u0b4d\u0b2a\u0b30\u0b3f\u0b15 \u0b28\u0b40\u0b33 \u0b2e\u0b3e\u0b1f\u0b3f\u0b2a\u0b3e\u0b24\u0b4d\u0b30\u0964",
        "pa": "\u0a2e\u0a3f\u0a71\u0a1f\u0a40 \u0a24\u0a4b\u0a02 \u0a2c\u0a3f\u0a28\u0a3e\u0a02 \u0a15\u0a41\u0a06\u0a30\u0a1f\u0a1c\u0a3c \u0a2a\u0a3e\u0a0a\u0a21\u0a30 \u0a28\u0a3e\u0a32 \u0a2c\u0a23\u0a40 \u0a1c\u0a48\u0a2a\u0a41\u0a30 \u0a26\u0a40 \u0a30\u0a35\u0a3e\u0a07\u0a24\u0a40 \u0a28\u0a40\u0a32\u0a40 \u0a2e\u0a3f\u0a71\u0a1f\u0a40 \u0a26\u0a40 \u0a15\u0a32\u0a3e\u0964"
